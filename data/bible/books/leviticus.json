    {
      "type": "story",
      "slug": "consecration-of-the-priests",
      "titleKo": "\uc544\ub860\uacfc \uc81c\uc0ac\uc7a5 \uc704\uc784",
      "titleEn": "Consecration of the Priests",
      "eyebrow": "STORIES \u00b7 LEVITICUS 8\u20139",
      "summary": "\ubaa8\uc138\uac00 \uc544\ub860\uacfc \uadf8\uc758 \uc544\ub4e4\ub4e4\uc744 \uc81c\uc0ac\uc7a5\uc73c\ub85c \uc704\uc784\ud558\uace0, \uc704\uc784 \uae30\uac04 \ud6c4 \uc544\ub860\uc774 \uccab \uc81c\uc0ac\ub97c \ub4dc\ub9ac\uba70 \uc81c\uc0ac\uc7a5 \uc9c1\ubb34\ub97c \uc2dc\uc791\ud558\ub294 \uc774\uc57c\uae30\uc785\ub2c8\ub2e4.",
      "overview": "\ub808\uc704\uae30 8\uc7a5\uc740 \ucd9c\uc560\uad7d\uae30\uc5d0\uc11c \uc9c0\uc2dc\ub41c \uc81c\uc0ac\uc7a5 \uc704\uc784 \uc808\ucc28\uac00 \uc2e4\uc81c\ub85c \uc2dc\ud589\ub418\ub294 \uc7a5\uba74\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \ubaa8\uc138\ub294 \uc544\ub860\uacfc \uadf8\uc758 \uc544\ub4e4\ub4e4\uc744 \uc53b\uae30\uace0 \uc81c\uc0ac\uc7a5 \uc758\ubcf5\uc744 \uc785\ud78c \ub4a4 \uae30\ub984\uc744 \ubd93\uace0 \uc81c\uc0ac\ub97c \ub4dc\ub9bd\ub2c8\ub2e4. \ub808\uc704\uae30 9\uc7a5\uc5d0\uc11c\ub294 \uc704\uc784 \uae30\uac04\uc744 \ub9c8\uce5c \uc544\ub860\uc774 \ubc31\uc131\uacfc \uc790\uc2e0\uc744 \uc704\ud55c \uc81c\uc0ac\ub97c \ub4dc\ub9ac\uba70 \uacf5\uc2dd\uc801\uc778 \uc81c\uc0ac\uc7a5 \uc9c1\ubb34\ub97c \uc2dc\uc791\ud569\ub2c8\ub2e4.",
      "heroImage": "/assets/scraptura-home-clean.jpg",
      "scenes": [
        {
          "number": "01",
          "title": "THE ASSEMBLY",
          "scripture": "Leviticus 8:1\u20135",
          "description": "\uc774\uc2a4\ub77c\uc5d8 \ud68c\uc911\uc774 \uc131\ub9c9 \uc785\uad6c\uc5d0 \ubaa8\uc774\uace0 \ubaa8\uc138\uac00 \uc544\ub860\uacfc \uadf8\uc758 \uc544\ub4e4\ub4e4\uc744 \ubd88\ub7ec \uc704\uc784 \uc808\ucc28\ub97c \uc2dc\uc791\ud569\ub2c8\ub2e4."
        },
        {
