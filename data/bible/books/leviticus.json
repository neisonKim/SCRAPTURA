      "eyebrow": "PEOPLE \u00b7 HIGH PRIEST",
      "summary": "\ubaa8\uc138\uc758 \ud615\uc774\uc790 \uc774\uc2a4\ub77c\uc5d8\uc758 \uccab \ub300\uc81c\uc0ac\uc7a5\uc73c\ub85c, \ucd9c\uc560\uad7d\uacfc \uc2dc\ub0b4\uc0b0 \uc2dc\ub300\ubd80\ud130 \uc81c\uc0ac\uc7a5 \uc81c\ub3c4\uc758 \ud615\uc131\uc5d0 \uc911\uc2ec\uc801\uc73c\ub85c \ub4f1\uc7a5\ud558\ub294 \uc778\ubb3c\uc785\ub2c8\ub2e4.",
      "overview": "\uc544\ub860\uc740 \ubaa8\uc138\uc640 \ud568\uaed8 \uc774\uc9d1\ud2b8\uc758 \ubc14\ub85c \uc55e\uc5d0 \uc11c\uba70 \ucd9c\uc560\uad7d \uacfc\uc815\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \uc2dc\ub0b4\uc0b0 \uc774\ud6c4\uc5d0\ub294 \uc544\ub860\uacfc \uadf8\uc758 \uc544\ub4e4\ub4e4\uc774 \uc81c\uc0ac\uc7a5 \uc9c1\ubb34\ub97c \ub9e1\uac8c \ub418\uace0, \ub808\uc704\uae30 8\u20139\uc7a5\uc5d0\uc11c \uc704\uc784\uc2dd\uacfc \uccab \uc81c\uc0ac\uac00 \uc9c4\ud589\ub429\ub2c8\ub2e4. \ub808\uc704\uae30 16\uc7a5\uc5d0\uc11c\ub294 \ub300\uc81c\uc0ac\uc7a5\uc774 \uc18d\uc8c4\uc77c\uc5d0 \uc218\ud589\ud574\uc57c \ud558\ub294 \uc5ed\ud560\uc774 \uc124\uba85\ub429\ub2c8\ub2e4.",
      "heroImage": "/assets/scraptura-home-clean.jpg",
      "characterJourney": [
        {
          "number": "01",
          "title": "WITH MOSES",
          "scripture": "Exodus 4\u201312",
          "description": "\uc544\ub860\uc740 \ubaa8\uc138\uc640 \ud568\uaed8 \ubc14\ub85c \uc55e\uc5d0 \uc11c\uba70 \ucd9c\uc560\uad7d \uc0ac\uac74\uc758 \ucd08\uae30 \uacfc\uc815\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4."
        },
        {
          "number": "02",
