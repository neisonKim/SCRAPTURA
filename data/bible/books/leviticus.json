  "nodes": [
    {
      "type": "book",
      "slug": "leviticus",
      "titleKo": "\ub808\uc704\uae30",
      "titleEn": "Leviticus",
      "eyebrow": "BIBLE \u00b7 OLD TESTAMENT \u00b7 TORAH",
      "summary": "\ub808\uc704\uae30\ub294 \uc2dc\ub0b4\uc0b0 \uc5b8\uc57d \uc774\ud6c4 \uc774\uc2a4\ub77c\uc5d8 \uacf5\ub3d9\uccb4\uac00 \uc81c\uc0ac\uc640 \uc815\uacb0, \uc81c\uc0ac\uc7a5 \uc9c1\ubb34, \uc18d\uc8c4\uc77c, \uac70\ub8e9\ud55c \uc0b6\uc744 \uc5b4\ub5bb\uac8c \uc774\ud574\ud558\uace0 \uc2e4\ucc9c\ud574\uc57c \ud558\ub294\uc9c0\ub97c \ub2e4\ub8e8\ub294 \ucc45\uc785\ub2c8\ub2e4.",
      "overview": "\ub808\uc704\uae30\ub294 \ucd9c\uc560\uad7d\uae30 \ud6c4\ubc18\uc758 \uc131\ub9c9 \uac74\ub9bd \uc774\ud6c4 \uc774\uc5b4\uc9c0\ub294 \ucc45\uc785\ub2c8\ub2e4. \ucd08\ubc18\uc5d0\ub294 \ubc88\uc81c\u00b7\uc18c\uc81c\u00b7\ud654\ubaa9\uc81c\u00b7\uc18d\uc8c4\uc81c\u00b7\uc18d\uac74\uc81c\uc640 \uac19\uc740 \uc81c\uc0ac \uaddc\ub840\uac00 \uc18c\uac1c\ub418\uace0, \uc774\uc5b4 \uc544\ub860\uacfc \uadf8\uc758 \uc544\ub4e4\ub4e4\uc758 \uc81c\uc0ac\uc7a5 \uc704\uc784, \uc815\uacb0\uacfc \ubd80\uc815\uc5d0 \uad00\ud55c \uaddc\ub840, \uc18d\uc8c4\uc77c\uc774 \uc804\uac1c\ub429\ub2c8\ub2e4. \ud6c4\ubc18\ubd80\uc5d0\ub294 \uacf5\ub3d9\uccb4\uc758 \uac70\ub8e9\ud55c \uc0b6, \uc81c\uc0ac\uc7a5 \uaddc\ub840, \uc808\uae30, \uc548\uc2dd\ub144\uacfc \ud76c\ub144, \uc11c\uc6d0\uc5d0 \uad00\ud55c \ub0b4\uc6a9\uc774 \uc774\uc5b4\uc9d1\ub2c8\ub2e4.",
      "biblicalContext": "SCRAPTURA\uc5d0\uc11c \ub808\uc704\uae30\ub294 \ucd9c\uc560\uad7d\uae30\uc640 \ubbfc\uc218\uae30 \uc0ac\uc774\ub97c \uc5f0\uacb0\ud558\ub294 \ud575\uc2ec Book Node\uc785\ub2c8\ub2e4. \ucd9c\uc560\uad7d\uae30\uc5d0\uc11c \uc138\uc6cc\uc9c4 \uc131\ub9c9\uc774 \uc2e4\uc81c \uc608\ubc30\uc640 \uacf5\ub3d9\uccb4 \uc0dd\ud65c\uc758 \uc911\uc2ec\uc73c\ub85c \uae30\ub2a5\ud558\uae30 \uc2dc\uc791\ud558\uba70, \ubaa8\uc138\uc640 \uc544\ub860\uc744 \uc911\uc2ec\uc73c\ub85c \uc81c\uc0ac\u00b7\uc815\uacb0\u00b7\uc18d\uc8c4\u00b7\uac70\ub8e9\uc774\ub77c\ub294 \uc8fc\uc81c\uac00 \uad6c\uccb4\ud654\ub429\ub2c8\ub2e4.",
      "heroImage": "/assets/scraptura-home-clean.jpg",
      "bookSections": [
        {
          "number": "01",
          "title": "OFFERINGS",
          "scripture": "Leviticus 1\u20137",
          "description": "\ubc88\uc81c, \uc18c\uc81c, \ud654\ubaa9\uc81c, \uc18d\uc8c4\uc81c, \uc18d\uac74\uc81c\uc640 \uad00\ub828\ub41c \uaddc\ub840\uac00 \uc18c\uac1c\ub418\uba70 \uc774\uc2a4\ub77c\uc5d8\uc758 \uc81c\uc0ac \uccb4\uacc4\uac00 \uc815\ub9ac\ub429\ub2c8\ub2e4."
        },
        {
          "number": "02",
          "title": "THE PRIESTS",
          "scripture": "Leviticus 8\u20139",
          "description": "\ubaa8\uc138\uac00 \uc544\ub860\uacfc \uadf8\uc758 \uc544\ub4e4\ub4e4\uc744 \uc81c\uc0ac\uc7a5\uc73c\ub85c \uc704\uc784\ud558\uace0, \uc81c\uc0ac\uc7a5 \uc9c1\ubb34\uac00 \uacf5\uc2dd\uc801\uc73c\ub85c \uc2dc\uc791\ub429\ub2c8\ub2e4."
        },
        {
          "number": "03",
          "title": "NADAB & ABIHU",
          "scripture": "Leviticus 10",
          "description": "\uc544\ub860\uc758 \uc544\ub4e4 \ub098\ub2f5\uacfc \uc544\ube44\ud6c4 \uc0ac\uac74\uc744 \ud1b5\ud574 \uc131\uc18c\uc640 \uc81c\uc0ac\uc7a5 \uc9c1\ubb34\uc758 \uc5c4\uc911\ud568\uc774 \uac15\uc870\ub429\ub2c8\ub2e4."
        },
        {
          "number": "04",
          "title": "CLEAN & UNCLEAN",
          "scripture": "Leviticus 11\u201315",
          "description": "\uc74c\uc2dd, \ucd9c\uc0b0, \ud53c\ubd80 \uc9c8\ud658\uacfc \uc720\ucd9c \ub4f1 \uc815\uacb0\uacfc \ubd80\uc815\uc5d0 \uad00\ud55c \uaddc\ub840\uac00 \uc774\uc5b4\uc9d1\ub2c8\ub2e4."
        },
        {
          "number": "05",
          "title": "DAY OF ATONEMENT",
          "scripture": "Leviticus 16",
          "description": "\ub300\uc81c\uc0ac\uc7a5\uc774 \uc9c0\uc131\uc18c\uc5d0 \ub4e4\uc5b4\uac00 \uacf5\ub3d9\uccb4\ub97c \uc704\ud574 \uc18d\uc8c4\ud558\ub294 \uc5f0\ub840 \uc758\uc2dd\uc774 \uc124\uba85\ub429\ub2c8\ub2e4."
        },
        {
          "number": "06",
          "title": "HOLINESS",
          "scripture": "Leviticus 17\u201320",
          "description": "\uc774\uc2a4\ub77c\uc5d8 \uacf5\ub3d9\uccb4\uc758 \uc608\ubc30\uc640 \uc77c\uc0c1\uc0dd\ud65c\uc5d0\uc11c \uac70\ub8e9\ud568\uc744 \uc9c0\ud0a4\uae30 \uc704\ud55c \uaddc\ub840\uac00 \uc804\uac1c\ub429\ub2c8\ub2e4."
        },
        {
          "number": "07",
          "title": "PRIESTS & SACRED THINGS",
          "scripture": "Leviticus 21\u201322",
          "description": "\uc81c\uc0ac\uc7a5\uc758 \uc790\uaca9\uacfc \uc131\ubb3c, \uc81c\ubb3c\uc5d0 \uad00\ud55c \uaddc\ub840\ub97c \ud1b5\ud574 \uc81c\uc0ac\uc7a5 \uc9c1\ubb34\uc758 \uae30\uc900\uc774 \uc81c\uc2dc\ub429\ub2c8\ub2e4."
        },
        {
          "number": "08",
          "title": "SACRED CALENDAR",
          "scripture": "Leviticus 23",
          "description": "\uc548\uc2dd\uc77c\uacfc \uc720\uc6d4\uc808, \ubb34\uad50\uc808, \uce60\uce60\uc808, \ub098\ud314\uc808, \uc18d\uc8c4\uc77c, \ucd08\ub9c9\uc808 \ub4f1 \uacf5\ub3d9\uccb4\uc758 \uc808\uae30\uac00 \uc815\ub9ac\ub429\ub2c8\ub2e4."
        },
        {
          "number": "09",
          "title": "THE SANCTUARY & COMMUNITY",
          "scripture": "Leviticus 24",
          "description": "\ub4f1\uc794\uacfc \uc9c4\uc124\ubcd1, \uacf5\ub3d9\uccb4 \uc548\uc5d0\uc11c \ubc1c\uc0dd\ud55c \uc0ac\uac74\uacfc \ubc95 \uc801\uc6a9\uc5d0 \uad00\ud55c \ub0b4\uc6a9\uc774 \uc774\uc5b4\uc9d1\ub2c8\ub2e4."
        },
        {
          "number": "10",
          "title": "SABBATH, JUBILEE & VOWS",
          "scripture": "Leviticus 25\u201327",
          "description": "\uc548\uc2dd\ub144\uacfc \ud76c\ub144, \uc5b8\uc57d\uc758 \ubcf5\uacfc \uacbd\uace0, \uc11c\uc6d0\uacfc \ubd09\ud5cc\uc5d0 \uad00\ud55c \uaddc\ub840\ub85c \ucc45\uc774 \ub9c8\ubb34\ub9ac\ub429\ub2c8\ub2e4."
        }
      ],
